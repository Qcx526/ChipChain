# Optional Phase 7 OpenAI-compatible provider. Never commit real credentials.
CHIPCHAIN_LLM_API_KEY=
CHIPCHAIN_LLM_BASE_URL=
CHIPCHAIN_LLM_MODEL=
CHIPCHAIN_LLM_API_STYLE=chat_completions
CHIPCHAIN_LLM_JSON_MODE=false
